# LeeWay Skills MCP Server / Context Gateway Configuration
# Copy to .env locally or configure these values in the deployment platform.
# Never commit real secrets or private evidence paths.

# Application
NODE_ENV=development
DEBUG=leeway-skills:*

# Existing local Skills MCP settings
LEEWAY_SKILLS_PATH=c:\Tools\Leeway-Skills
REGISTRY_PATH=c:\Tools\Leeway-Skills\scripts\skills-registry.json
MCP_PORT=3000
MCP_HOST=localhost

# Remote MCP Context Gateway
LEEWAY_MCP_PORT=8788
LEEWAY_MCP_HOST=0.0.0.0
# REQUIRED in NODE_ENV=production. Comma-separated hostnames only.
LEEWAY_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional bearer token protecting /api/admin/config. Set only in runtime secret storage.
# LEEWAY_ADMIN_TOKEN=

# Canonical evidence exports. Omit any unavailable source: the gateway will report UNVERIFIED/NOT_CONFIGURED.
# Set A: codebase AST / Git diff / engineering context JSON
# LEEWAY_SET_A_FILE=/run/leeway/context/set-a.json
# Set B: Runtime Fabric health / Veritas receipts JSON
# LEEWAY_SET_B_FILE=/run/leeway/context/set-b.json
# Set C: Roblox / universe / domain metadata JSON
# LEEWAY_SET_C_FILE=/run/leeway/context/set-c.json
# Set D: optional capability registry override JSON; defaults to repository skill-registry metadata
# LEEWAY_SET_D_FILE=/run/leeway/context/set-d.json

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIR=.leeway/logs

# Existing features
ENABLE_CACHE=true
CACHE_TTL=3600
ENABLE_INTROSPECTION=true
ENABLE_CHAINING=true

# Performance
MAX_CONCURRENT_EXECUTIONS=5
EXECUTION_TIMEOUT=30000

# Governance
ENABLE_LEEWAY_GOVERNANCE=true
COMPLIANCE_CHECK=true
AUDIT_LOGGING=true
