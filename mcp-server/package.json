{
  "name": "@leeway/skills-mcp-server",
  "version": "1.1.0",
  "description": "LeeWay Skills MCP Server and governed zero-search-debt context gateway for AI agents",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./http": "./dist/http.js",
    "./context-harness": "./dist/context-harness.js",
    "./badge-proof": "./dist/badge-proof.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsc && node dist/index.js",
    "dev:http": "tsc && node dist/http.js",
    "badge:install": "node dist/install-badge-proof.js",
    "prebuild": "npm run clean",
    "clean": "node -e \"require('fs').rmSync('dist',{ recursive: true, force: true })\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "leeway-skills",
    "context-gateway",
    "agent",
    "tools",
    "resources",
    "prompts",
    "ai"
  ],
  "author": "Leeway Industries (By Leonard Jerome Lee)",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/4citeB4U/LeeWay-Agent-Skills.git"
  }
}
