{
  "name": "@leeway/skills-mcp-server",
  "version": "1.0.0",
  "description": "Leeway Skills MCP Server - Expose Leeway Skills as callable MCP tools for AI agents",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./badge-proof": "./dist/badge-proof.js",
    "./blender-mcp": "./dist/blender-mcp-server.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/game-development-tools.test.js",
    "test:protocol": "node scripts/protocol-smoke.mjs",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "blender:start": "node dist/blender-mcp-server.js",
    "blender:dev": "tsc && node dist/blender-mcp-server.js",
    "badge:install": "node dist/install-badge-proof.js",
    "prebuild": "npm run clean",
    "clean": "node -e \"require('fs').rmSync('dist',{ recursive: true, force: true })\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "leeway-skills",
    "blender",
    "3d",
    "agent",
    "tools",
    "ai"
  ],
  "author": "Leeway Industries (By Leonard Jerome Lee)",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "local"
  }
}
