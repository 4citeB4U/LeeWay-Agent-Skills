    "leeway-book-design-production",
    "leeway-cover-illustration-coordination",
    "leeway-epub-production",
    "leeway-epub-accessibility",
    "leeway-epub-validation",
    "leeway-publishing-metadata-identifiers",
    "leeway-publishing-rights-permissions",
    "leeway-publishing-distribution-release",
    "leeway-literary-sun",
    "leeway-veritas"
  ],
  "catalogSeparation": {
    "manuscript": "creative content",
    "edition": "format/version/identifier/cover/metadata",
